generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  spyId        String   @unique
  email        String   @unique
  passwordHash String
  roleSpy      Boolean  @default(true)
  roleTarget   Boolean  @default(false)
  points       Int      @default(0)
  totalSolved  Int      @default(0)
  createdAt    DateTime @default(now())
  profile      Profile?
  spyCases     Case[]   @relation("SpyCases")
  targetCases  Case[]   @relation("TargetCases")
}

model Profile {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName String
  lastName  String
  birthDate DateTime
  gender    String
  city      String   @default("Москва")

  eduUniversity String?
  eduFaculty    String?
  eduLevel      String?
  eduCourse     Int?

  workPlace  String?
  workSphere String?

  socials      Json?
  uniqueDetail String?
}

// Кейс: шпион ищет цель по подсказкам
model Case {
  id           Int      @id @default(autoincrement())
  spyUserId    String
  spy          User     @relation("SpyCases", fields: [spyUserId], references: [id], onDelete: Cascade)
  targetUserId String
  target       User     @relation("TargetCases", fields: [targetUserId], references: [id], onDelete: Cascade)
  status       String   @default("active") // active | solved | failed | declined
  attemptsLeft Int      @default(10)
  difficulty   String   @default("easy") // easy | medium | hard | insane
  reward       Int      @default(30) // баллы за поимку цели
  createdAt    DateTime @default(now())

  @@index([spyUserId, status])
  @@index([targetUserId])
}
