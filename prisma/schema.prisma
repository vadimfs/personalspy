generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  spyId        String   @unique
  email        String   @unique
  passwordHash String
  roleSpy      Boolean  @default(true)
  roleTarget   Boolean  @default(false)
  points       Int      @default(0)
  totalSolved  Int      @default(0)
  createdAt    DateTime @default(now())
  profile      Profile?
}

model Profile {
  userId       String   @id
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName    String
  lastName     String
  birthDate    DateTime
  gender       String
  city         String   @default("Москва")
  
  eduUniversity String?
  eduFaculty    String?
  eduLevel      String?
  eduCourse     Int?
  
  workPlace    String?
  workSphere   String?
  
  socials      Json?    
  uniqueDetail String?
}